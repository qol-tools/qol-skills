{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/check-pathway-doc.cjs"
                    },
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/check-pathway-md.cjs"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/check-pr.cjs"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/cleanup-worktree.cjs"
                    }
                ]
            }
        ]
    }
}
