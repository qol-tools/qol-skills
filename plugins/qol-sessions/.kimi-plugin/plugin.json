{
  "name": "qol-sessions",
  "version": "0.8.25",
  "description": "Architect-to-implementer feature loop for independent terminals with event-signalled rounds, explicit closure, and a canonical final report.",
  "author": {
    "name": "KMRH47"
  },
  "skills": [
    "./skills/"
  ],
  "hooks": [
    {
      "event": "UserPromptSubmit",
      "command": "node hooks/qols-intercept.mjs"
    },
    {
      "event": "UserPromptSubmit",
      "command": "node bin/inject-session-bridge-context.cjs"
    },
    {
      "event": "Stop",
      "command": "node bin/guard-session-feature-loop.cjs"
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash|mcp__.*session_bridge",
      "command": "node bin/deny-watched-round-wait.cjs"
    },
    {
      "event": "PreToolUse",
      "matcher": "AskUserQuestion",
      "command": "node bin/deny-lane-ask-user.cjs"
    }
  ]
}
