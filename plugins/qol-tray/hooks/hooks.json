{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume|clear",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/bin/inject-dev-recompile-context.cjs"
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "matcher": "qol-tray-frontend|qol-tray-backend",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/bin/reflect-agent.cjs"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/bin/stop-deny-uncited-arch-claims.cjs"
                    }
                ]
            }
        ]
    }
}
