{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/check-qol-arch-code.cjs"
                    },
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/check-qol-arch-cross-platform.cjs"
                    },
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/check-qol-arch-cicd.cjs"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/qol-mission-reminder.cjs"
                    }
                ]
            }
        ]
    }
}
