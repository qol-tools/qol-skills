{
  "name": "qol-workflow",
  "version": "0.4.8",
  "description": "Cross-cutting workflow conventions for any qol-tools repo: commit message conventions (with the no-attribution hard rule), git push and worktree workflows, and universal coding guidelines. Ships PreToolUse(Bash) hooks that (1) inject commit context, (2) block AI-attribution lines, (3) block branch-creation/switching inside a qol-* main clone (worktrees-only rule).",
  "author": {
    "name": "KMRH47"
  },
  "skills": [
    "./skills/"
  ],
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "node bin/commit-skill-context.cjs"
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "node bin/commit-deny-coauthor.cjs"
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "node bin/branch-deny-checkout-in-main-clone.cjs"
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "node bin/branch-deny-agent-checkout.cjs"
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "node bin/branch-deny-pid-branch-name.cjs"
    },
    {
      "event": "UserPromptSubmit",
      "command": "node bin/qol-cicd-context.cjs"
    },
    {
      "event": "UserPromptSubmit",
      "command": "node bin/qol-monorepo-rules-context.cjs"
    }
  ]
}
