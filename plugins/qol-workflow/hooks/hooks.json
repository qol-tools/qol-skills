                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/bin/commit-skill-context.cjs"
                    },
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/bin/commit-deny-coauthor.cjs"
                    },
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/bin/branch-deny-checkout-in-main-clone.cjs"
                    },
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/bin/branch-deny-agent-checkout.cjs"
                    },
                    {
                        "type": "command",
                        "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/bin/branch-deny-pid-branch-name.cjs"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
